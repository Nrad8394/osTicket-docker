# KRA osTicket Database Seeding System
# Environment Configuration
# Generated for Docker Compose environment

# ═══════════════════════════════════════════════════════════════
#  Database Configuration
# ═══════════════════════════════════════════════════════════════

# MySQL Host (use 'localhost' when running seeding from host, 'db' from within Docker)
MYSQL_HOST=localhost

# MySQL Port
MYSQL_PORT=3306

# osTicket Database Name
MYSQL_DATABASE=osticket

# Database User
MYSQL_USER=osticket

# Database Password
MYSQL_PASSWORD=0sT1ck3tPass!

# Table Prefix (should match ost-config.php)
MYSQL_PREFIX=ost_

# ═══════════════════════════════════════════════════════════════
#  Seeding Configuration
# ═══════════════════════════════════════════════════════════════

# Enable/disable seeding
SEEDING_ENABLED=true

# Seeding mode: full | partial | reset | validate | rollback
# full    = INSERT/UPDATE all records (non-destructive, recommended)
# partial = INSERT IGNORE only (safe, skips duplicates)
# reset   = Reserved for future use
# validate= Check only, don't modify
# rollback= Restore from backup
SEEDING_MODE=partial

# Seeding version (for tracking)
SEEDING_VERSION=1.0

# Dry run: if true, don't commit changes (test only)
SEEDING_DRY_RUN=false

# Create backup before seeding
SEEDING_BACKUP=false

# Verbose logging
SEEDING_VERBOSE=true

# Include demo data (optional)
SEEDING_INCLUDE_DEMO=true

# Log file location
SEEDING_LOG_FILE=logs/main.log

# ═══════════════════════════════════════════════════════════════
#  API Configuration for Auto-Creating Tickets
# ═══════════════════════════════════════════════════════════════

# osTicket base URL (e.g., http://localhost/support)
OSTICKET_URL=http://localhost/support

# osTicket API Key (from Admin > Settings > API Keys)
OSTICKET_API_KEY=B0FBB7AFC89B9C062A8CA6BF053FFAA9
