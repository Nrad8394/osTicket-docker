# ═══════════════════════════════════════════════════════════════
#  osTicket Docker — Environment Configuration
#  Copy this file to .env and fill in your values
#  All values here become the live configuration on first boot
# ═══════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=R00tS3cur3Pass!
MYSQL_DATABASE=osticket
MYSQL_USER=osticket
MYSQL_PASSWORD=0sT1ck3tPass!
MYSQL_PREFIX=ost_

# ── osTicket Admin Account ───────────────────────────────────────
# Created automatically on first boot — use these to log in
OST_ADMIN_EMAIL=admin@yourdomain.com
OST_ADMIN_FNAME=Admin
OST_ADMIN_LNAME=User
OST_ADMIN_USER=ostadmin
OST_ADMIN_PASS=Adm1nP@ss!

# ── Site Settings ────────────────────────────────────────────────
OST_SITE_NAME=Support Center
OST_SITE_EMAIL=support@yourdomain.com
# Set this to the actual URL your helpdesk will be accessed at
OST_HELPDESK_URL=http://localhost:8080

# ── App Port ─────────────────────────────────────────────────────
APP_PORT=8080
